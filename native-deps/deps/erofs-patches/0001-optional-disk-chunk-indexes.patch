+	}
+	blob_hashmap.table = table;
+	blob_hashmap.tablesize = 64;
+	blob_hashmap.grow_at = 64 * 80 / 100;
+	blob_hashmap.cmpfn = erofs_blob_hashmap_cmp;
+	if (chunksize > PTRDIFF_MAX) {
+		ret = -EOVERFLOW;
+		goto fail;
+	}
+	ret = erofs_insert_zerochunk(chunksize);
+	if (!ret)
+		return 0;
+fail:
+	erofs_blob_exit();
+	return ret;
 }
diff --git a/lib/index.c b/lib/index.c
new file mode 100644
index 0000000..5df929b
--- /dev/null
+++ b/lib/index.c
@@ -0,0 +1,136 @@
+// SPDX-License-Identifier: GPL-2.0+ OR Apache-2.0
+#define _GNU_SOURCE
+#include "erofs/defs.h"
+#include "erofs/print.h"
+#include "liberofs_index.h"
+#include <fcntl.h>
+#include <stdlib.h>
+#include <unistd.h>
+#ifdef HAVE_SYS_MMAN_H
+#include <sys/mman.h>
+#endif
+#ifdef __linux__
+#include <linux/magic.h>
+#include <sys/vfs.h>
+#endif
+
+int erofs_index_open(void)
+{
+#ifdef __linux__
+	const char *dir = getenv("TMPDIR");
+	struct statfs st;
+	int fd, err;
+
+	if (!dir || !*dir) {
+		erofs_err("EROFS_INDEX_STORAGE=disk requires TMPDIR on disk storage");
+		return -EINVAL;
+	}
+	fd = open(dir, O_RDONLY | O_DIRECTORY | O_CLOEXEC);
+	if (fd < 0) {
+		err = -errno;
+		erofs_err("disk index directory %s: %s", dir, strerror(-err));
+		return err;
+	}
+	if (fstatfs(fd, &st)) {
+		err = -errno;
+		erofs_err("disk index filesystem check: %s", strerror(-err));
+		goto fail;
+	}
+	if (st.f_type == TMPFS_MAGIC || st.f_type == RAMFS_MAGIC) {
+		err = -EOPNOTSUPP;
+		erofs_err("disk index TMPDIR must not use tmpfs or ramfs: %s", dir);
+		goto fail;
+	}
+	return fd;
+fail:
+	close(fd);
+	return err;
+#else
+	erofs_err("EROFS_INDEX_STORAGE=disk requires Linux");
+	return -EOPNOTSUPP;
+#endif
+}
+
+static size_t erofs_index_mapsize(size_t bytes)
+{
+	long pagesize = sysconf(_SC_PAGESIZE);
+	size_t size;
+
+	if (pagesize <= 0 || !bytes || bytes > PTRDIFF_MAX ||
+	    bytes > SIZE_MAX - (pagesize - 1))
+		return 0;
+	size = (bytes + pagesize - 1) / pagesize * pagesize;
+	if (size > PTRDIFF_MAX || size > INT64_MAX ||
+	    sizeof(off_t) < sizeof(int64_t))
+		return 0;
+	return size;
+}
+
+void *erofs_index_mmap(int dirfd, size_t bytes)
+{
+#if defined(__linux__) && defined(HAVE_FALLOCATE) && defined(O_TMPFILE)
+	size_t size = erofs_index_mapsize(bytes);
+	const char *operation = "size";
+	void *p;
+	int fd = -1, err = -EOVERFLOW, ret;
+
+	if (!size)
+		goto fail;
+	operation = "create O_TMPFILE";
+	fd = openat(dirfd, ".", O_TMPFILE | O_RDWR | O_CLOEXEC, 0600);
+	if (fd < 0) {
+		err = -errno;
+		goto fail;
+	}
+	/* ftruncate would leave holes: reserve before exposing writable pages.
+	 * Probe capabilities, not filesystem names. Unsupported reservation is
+	 * fatal, as are ENOSPC and quota errors; there is no heap fallback.
+	 */
+	operation = "reserve";
+	do {
+		ret = fallocate(fd, 0, 0, size);
+	} while (ret && errno == EINTR);
+	if (ret) {
+		err = -errno;
+		goto fail;
+	}
+	operation = "mmap";
+	p = mmap(NULL, size, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+	if (p == MAP_FAILED) {
+		err = -errno;
+		goto fail;
+	}
+	/* The mapping retains its unlinked file, without a descriptor per
+	 * allocation. Never extend/remap a live allocation. No durability or
+	 * protection against media faults is implied by successful reservation.
+	 */
+	if (close(fd)) {
+		err = -errno;
+		fd = -1;
+		operation = "close";
+		erofs_index_munmap(p, bytes);
+		goto fail;
+	}
+	return p;
+fail:
+	if (fd >= 0)
+		close(fd);
+	erofs_err("disk index %s (%zu bytes): %s", operation, bytes, strerror(-err));
+	return ERR_PTR(err);
+#else
+	erofs_err("disk indexes require Linux O_TMPFILE, fallocate and mmap support");
+	return ERR_PTR(-EOPNOTSUPP);
+#endif
+}
+
+void erofs_index_munmap(void *ptr, size_t bytes)
+{
+#ifdef HAVE_SYS_MMAN_H
+	size_t size = erofs_index_mapsize(bytes);
+
+	if (size && !munmap(ptr, size))
+		return;
+#endif
+	erofs_err("invalid disk index release (%zu bytes)", bytes);
+	abort();
+}
