+int erofs_blob_init_storage(void)
+{
+	const char *value = getenv("EROFS_INDEX_STORAGE");
+	int fd;
+
+	if (blob_storage_initialized)
+		return 0;
+	if (value && strcmp(value, "memory")) {
+		if (strcmp(value, "disk")) {
+			erofs_err("EROFS_INDEX_STORAGE must be memory or disk");
+			return -EINVAL;
+		}
+		fd = erofs_index_open();
+		if (fd < 0)
+			return fd;
+		blob_index_fd = fd;
+	}
+	blob_storage_initialized = true;
+	return 0;
+}
+
+static struct erofs_blobchunk *blob_alloc_chunk(bool zero)
+{
+	struct blob_record_segment *seg = blob_record_segments;
+	struct erofs_blobchunk *chunk;
+
+	if (blob_index_fd < 0) {
+		chunk = zero ? calloc(1, sizeof(*chunk)) : malloc(sizeof(*chunk));
+		return chunk ? chunk : ERR_PTR(-ENOMEM);
+	}
+	if (!seg || seg->used == BLOB_RECORD_SEGMENT_SIZE / sizeof(*chunk)) {
+		seg = malloc(sizeof(*seg));
+		if (!seg)
+			return ERR_PTR(-ENOMEM);
+		seg->chunks = erofs_index_mmap(blob_index_fd, BLOB_RECORD_SEGMENT_SIZE);
+		if (IS_ERR(seg->chunks)) {
+			chunk = seg->chunks;
+			free(seg);
+			return chunk;
+		}
+		seg->used = 0;
+		seg->next = blob_record_segments;
+		blob_record_segments = seg;
+	}
+	/* New file pages are zeroed; published records never move or recycle. */
+	return seg->chunks + seg->used++;
+}
