+/* Keep checked growth local to chunk indexing. The generic hashmap and its
+ * other users retain their original allocator and API. Match its 64-bucket
+ * start, 80% load, fourfold growth, insertion order and chain reversal.
+ */
+static int blob_hashmap_add(struct erofs_blobchunk *chunk)
+{
+	struct hashmap *map = &blob_hashmap;
+	struct hashmap_entry **table = NULL;
+	unsigned int size = map->tablesize, i;
+
+	if (map->size == UINT_MAX)
+		return -EOVERFLOW;
+	if (map->size + 1 > map->grow_at) {
+		if (size > UINT_MAX / 4)
+			return -EOVERFLOW;
+		table = blob_alloc_buckets(size * 4);
+		if (IS_ERR(table))
+			return PTR_ERR(table);
+	}
+	/* Reserve first, so failure leaves both the map and caller ownership
+	 * intact. Link before rehashing, exactly as the upstream hashmap does.
+	 */
+	i = chunk->ent.hash & (size - 1);
+	chunk->ent.next = map->table[i];
+	map->table[i] = &chunk->ent;
+	++map->size;
+	if (!table)
+		return 0;
+	for (i = 0; i < size; ++i) {
+		struct hashmap_entry *entry = map->table[i];
+
+		while (entry) {
+			struct hashmap_entry *next = entry->next;
+			unsigned int bucket = entry->hash & (size * 4 - 1);
+
+			entry->next = table[bucket];
+			table[bucket] = entry;
+			entry = next;
+		}
+	}
+	blob_free_buckets(map->table, size);
+	map->table = table;
+	map->tablesize = size * 4;
+	map->grow_at = (uint64_t)map->tablesize * 80 / 100;
+	return 0;
+}
