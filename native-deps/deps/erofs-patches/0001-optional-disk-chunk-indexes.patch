+/* Large enough to avoid one VMA per record (and premature max_map_count
+ * exhaustion), without reserving a large arena for a small build.
+ */
+#define BLOB_RECORD_SEGMENT_SIZE (4U * 1024 * 1024)
+#define BLOB_INDEX_MMAP_MIN (16U * 1024)
+static int blob_index_fd = -1;
+static bool blob_storage_initialized;
+static struct blob_record_segment {
+	struct blob_record_segment *next;
+	struct erofs_blobchunk *chunks;
+	size_t used;
+} *blob_record_segments;
