+	inode->chunkindexes = NULL;
+	inode->chunkindexes_mmap_size = 0;
+	if (blob_index_fd >= 0 && bytes >= BLOB_INDEX_MMAP_MIN) {
+		p = erofs_index_mmap(blob_index_fd, bytes);
+		if (IS_ERR(p))
