+	if (!count || bytes / sizeof(*table) != count || bytes > PTRDIFF_MAX)
+		return ERR_PTR(-EOVERFLOW);
+	if (blob_index_fd >= 0)
+		return erofs_index_mmap(blob_index_fd, bytes);
+	table = calloc(count, sizeof(*table));
+	return table ? table : ERR_PTR(-ENOMEM);
+}
+
+static void blob_free_buckets(struct hashmap_entry **table, unsigned int count)
+{
