# x86_64-specific kernel config fragment for the sandbox guest.
# Merged with sandbox-common.config by deps/build-vmlinux.sh.

# === Hypervisor / boot protocol (x86-only) ===
# PVH boot lets cloud-hypervisor jump straight to the ELF kernel entry
# without a BIOS or PV bootloader. CONFIG_XEN is the umbrella; CONFIG_PVH
# is the boot-protocol path; CONFIG_XEN_PVH wires up the ELF note CH reads.
# RANDOMIZE_MEMORY is also x86-only. The current minimal preset leaves it off
# as an explicit security tradeoff, not as a snapshot-sharing requirement.
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_PARAVIRT_SPINLOCKS=y
CONFIG_KVM_GUEST=y
CONFIG_PARAVIRT_CLOCK=y
CONFIG_XEN=y
CONFIG_XEN_PVH=y
CONFIG_PVH=y
# Cloud Hypervisor describes vCPUs with Processor Local x2APIC (MADT type 9)
# entries. Without this option Linux ignores every declared vCPU and keeps only
# its fallback boot CPU, even when CONFIG_SMP and CONFIG_NR_CPUS are correct.
CONFIG_X86_X2APIC=y
# CONFIG_XEN_PV is not set
# CONFIG_XEN_PVHVM is not set
# CONFIG_XEN_DOM0 is not set
# CONFIG_RANDOMIZE_MEMORY is not set

# === RTC (CH provides CMOS RTC on x86) ===
CONFIG_RTC_DRV_CMOS=y

# === PCI MMCONFIG (x86 ECAM via MCFG ACPI table) ===
CONFIG_PCI_MMCONFIG=y

# === Disable IOMMU (KVM guest) ===
# CONFIG_INTEL_IOMMU is not set
# CONFIG_AMD_IOMMU is not set
