# arm64-specific kernel config fragment for the sandbox guest.
# Merged with sandbox-common.config by deps/build-vmlinux.sh.
#
# Boot model on arm64: cloud-hypervisor loads the PE-format Image, sets
# up FDT/ACPI, and jumps to the EFI stub entry. Kernel needs EFI_STUB,
# ACPI, GICv3, PSCI, and the PL011 UART driver to function as a CH guest.

# === Page size: pin 4 KiB ===
# Userfaultfd page granularity is hardcoded as PAGE_SIZE inside the kernel.
# sandbox-ctl's uffd handler reasons in 4 KiB pages; if a distro defconfig
# enables CONFIG_ARM64_64K_PAGES (some Red Hat / SUSE arm64 builds do),
# every UFFD batch boundary breaks. Pin 4K explicitly.
CONFIG_ARM64_4K_PAGES=y
# CONFIG_ARM64_16K_PAGES is not set
# CONFIG_ARM64_64K_PAGES is not set

# === Virtual address bits ===
# 48-bit VA / 48-bit PA is the most widely supported configuration on
# server-class arm64 silicon (Graviton2/3, Ampere, Apple M-series via KVM).
CONFIG_ARM64_VA_BITS_48=y

# === Interrupt controller: GICv3 + ITS ===
# cloud-hypervisor presents GICv3 to arm64 guests; ITS provides MSI
# routing for virtio-pci devices (counterpart of x86 PCI_MSI).
CONFIG_ARM_GIC_V3=y
CONFIG_ARM_GIC_V3_ITS=y
# CONFIG_ARM_GIC is not set
# CONFIG_ARM_GIC_V2M is not set

# === PSCI (CPU power state coordination) ===
# arm64 has no IPI/SIPI; PSCI is the standard way SMP secondaries are
# brought up under a hypervisor. KVM/CH speak PSCI 1.0+.
CONFIG_ARM_PSCI=y
CONFIG_HVC_DRIVER=y

# === ACPI + EFI stub boot ===
# CH boots arm64 guests via the EFI stub with an ACPI tables blob;
# both must be enabled to find PCI host bridge, RTC, and CPU topology.
CONFIG_ACPI=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y

# === PCI host controller (generic ECAM) ===
# arm64 has no fixed PCI MMCONFIG region; the host bridge appears via
# ACPI/DT as a generic ECAM controller. virtio-pci devices attach below.
CONFIG_PCI_HOST_GENERIC=y
CONFIG_PCI_HOST_COMMON=y
CONFIG_PCI_ECAM=y

# === Serial console (PL011) ===
# CH exposes a PL011 UART on arm64 for the kernel boot console
# (counterpart of the 8250 port on x86).
CONFIG_ARM_AMBA=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y

# === Architected timer ===
# arm64 generic timer (no PARAVIRT_CLOCK equivalent needed).
CONFIG_ARM_ARCH_TIMER=y

# === RTC ===
# arm64 has no CMOS RTC; CH/QEMU expose an MMIO PL031 RTC instead.
CONFIG_RTC_DRV_PL031=y

# === Disable arm64-specific debug bits ===
# CONFIG_HARDEN_BRANCH_PREDICTOR is not set
